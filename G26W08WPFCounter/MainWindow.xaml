<Window x:Class="G26W08WPFCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:G26W08WPFCounter"
        mc:Ignorable="d"
        Title="카운터" Height="538" Width="382">
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="/Images/diego-jimenez-A-NVHPka9Rk-unsplash.jpg"/>
        </Grid.Background>
        <Button x:Name="BtnAdd" Content="증가" HorizontalAlignment="Center" Height="36" Margin="0,143,0,0" VerticalAlignment="Top" Width="362" FontSize="24" Click="OnAdd"/>
        <TextBox x:Name="TxtCount" HorizontalAlignment="Center" Height="74" Margin="0,33,0,0" TextWrapping="Wrap" Text="counter" VerticalAlignment="Top" Width="362" TextAlignment="Center" FontSize="48" TextChanged="TxtCount_TextChanged" Background="#FFEFF304"/>
        <Button Content="감소" HorizontalAlignment="Center" Height="39" Margin="0,202,0,0" VerticalAlignment="Top" Width="362" FontSize="24" Click="OnSub"/>

    </Grid>
</Window>
